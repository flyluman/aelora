# Docker-first local testing defaults.
# If you run the backend directly on your host instead of Docker Compose,
# change Valkey/Postgres hosts and any helper ports to host-local values in your `.env`.
AELORA_APP_ENV=dev
AELORA_HTTP_ADDR=:8080
AELORA_LOG_LEVEL=info
AELORA_SERVICE_NAME=aelora
AELORA_FRONTEND_SIDECAR_ENABLED=false
AELORA_FRONTEND_ADDR=:8081
AELORA_WS_READ_LIMIT=4096
AELORA_WS_CHECK_ORIGIN=false

AELORA_AUTH_ENABLED=false
AELORA_COGNITO_REGION=us-east-1
AELORA_COGNITO_USER_POOL_ID=us-east-1_xxxxx
AELORA_COGNITO_APP_CLIENT_ID=xxxxxxxx

AELORA_VALKEY_ADDR=valkey:6379
AELORA_VALKEY_USERNAME=
AELORA_VALKEY_PASSWORD=
AELORA_VALKEY_DB=0
AELORA_VALKEY_EVENT_STREAM_KEY=stream:events:message_created
AELORA_VALKEY_ROOM_STREAM_MAXLEN=20000
AELORA_VALKEY_EVENT_STREAM_MAXLEN=50000
AELORA_VALKEY_ROOM_ID_SEQUENCE_KEY=seq:room_id
AELORA_ROOM_ID_XOR_MASK=134454654780389
AELORA_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/aelora?sslmode=disable
AELORA_RUN_MIGRATIONS_ON_START=true
AELORA_SEND_RATE_LIMIT_PER_SECOND=30
AELORA_SEND_RATE_LIMIT_TTL_SECONDS=300
AELORA_POSTGRES_MIGRATIONS_DIR=migrations/postgres

# Optional push gateway endpoints for offline Android/iOS notifications.
AELORA_PUSH_ANDROID_ENDPOINT=
AELORA_PUSH_IOS_ENDPOINT=
AELORA_PUSH_AUTH_TOKEN=
AELORA_PUSH_HTTP_TIMEOUT_MS=2000
